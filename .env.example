APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
AI_API_KEY=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-different-platform-admin-secret
WRITE_RATE_LIMIT_PER_MINUTE=120
MAX_BATCH_SIZE=100
LEARNING_RATE=0.12
RAW_EVENT_RETENTION_HOURS=72
PRUNE_INTERVAL_SECONDS=3600
MAX_ARCHIVED_VERSIONS=20

# Solo para desarrollo local o un volumen persistente:
# SQLITE_PATH=/data/zombie_ai_brain_v2.db
